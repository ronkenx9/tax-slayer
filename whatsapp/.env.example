# ─── AI Engine ────────────────────────────────────────────────────────────────
# Groq API key — fast llama-3.3-70b inference (FREE at https://console.groq.com)
GROQ_API_KEY=gsk_...

# ─── Blockchain Data (Moralis) ────────────────────────────────────────────────
# Sign up FREE at https://moralis.io → API Keys
MORALIS_API_KEY=your_moralis_api_key_here

# ─── (Optional) Zerion — x402 fallback for data requests ─────────────────────
ZERION_API_KEY=your_zerion_api_key_here
MOONPAY_WALLET=main

# ─── Report Pricing ───────────────────────────────────────────────────────────
REPORT_PRICE_USD=10

# ─── Telegram Bot ────────────────────────────────────────────────────────────
# Get from @BotFather on Telegram → /newbot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ─── Payment (MoonPay) ────────────────────────────────────────────────────────
# Publishable key from https://dashboard.moonpay.com → Dev resources
MOONPAY_PK=pk_live_...
# Your USDC receiving address (from your OWS / MoonPay wallet)
PAYMENT_WALLET=0xYourUSDCReceivingAddressHere

# ─── OWS Agent Wallet ────────────────────────────────────────────────────────
OWS_WALLET_NAME=tax-slayer-agent

# ─── WhatsApp (optional — scan QR at startup) ────────────────────────────────
# No env var needed — scans QR code with any WhatsApp account
# Use a spare phone/SIM for a dedicated bot number
