# ─── Zerion (primary data source via x402) ────────────────────────
ZERION_API_KEY=zk_your_zerion_key_here

# ─── Moralis (fallback if Zerion mp x402 fails on Railway) ────────
MORALIS_API_KEY=your_moralis_jwt_here

# ─── Payment wallet (receives $10 USDC from users) ────────────────
PAYMENT_WALLET=0xYourWalletAddressHere
X402_RECEIVER_ADDRESS=0xYourWalletAddressHere

# ─── Report pricing ────────────────────────────────────────────────
REPORT_PRICE_USD=10

# ─── Telegram bot ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ─── Groq AI brain ─────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_key_here

# ─── Public URL (set to Railway domain after deploy) ───────────────
# Example: PUBLIC_URL=https://tax-slayer-telegram-production.up.railway.app
PUBLIC_URL=https://PASTE_YOUR_RAILWAY_URL_HERE
